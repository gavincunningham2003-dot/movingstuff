# CATRIX — example environment configuration. Copy to .env and adjust.
CATRIX_ENV=development
CATRIX_LOG_LEVEL=INFO
CATRIX_LOG_JSON=false

# PostgreSQL / PostGIS
CATRIX_DATABASE_URL=postgresql+psycopg://catrix:catrix@localhost:5432/catrix
CATRIX_TEST_DATABASE_URL=postgresql+psycopg://catrix:catrix@localhost:5432/catrix_test

# Data directories (relative to repository root unless absolute)
CATRIX_DATA_DIR=./data
CATRIX_RANDOM_SEED=42

# HTTP behaviour for dataset connectors
CATRIX_HTTP_TIMEOUT_SECONDS=60
CATRIX_HTTP_MAX_RETRIES=4
CATRIX_HTTP_USER_AGENT=catrix/0.1 (+https://github.com/example/catrix)

# OpenAddresses batch downloads require a free account token (https://batch.openaddresses.io).
# Leave empty to use a locally supplied OpenAddresses file instead.
CATRIX_OPENADDRESSES_TOKEN=

# Ingestion sample size (addresses) and batch size
CATRIX_ADDRESS_SAMPLE_SIZE=15000
CATRIX_BATCH_SIZE=500

# MLflow (optional)
CATRIX_MLFLOW_TRACKING_URI=./mlruns

# XGBoost training device: cpu (default) or cuda for an NVIDIA GPU
CATRIX_ML_DEVICE=cpu

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# LANDFIRE Product Service needs a contact e-mail for each raster job
CATRIX_LANDFIRE_EMAIL=
